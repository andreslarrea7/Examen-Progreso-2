import java.util.ArrayList;

public class Curso {
    int codigo;
    String nombre;
    int creditos;
    Profesor profesor;
    ArrayList<Estudiante> estudiantes = new ArrayList<>();

    public Curso(int codigo, String nombre, int creditos) {
        this.codigo = codigo;
        this.codigo = codigo;
        this.nombre = nombre;
        this.creditos = creditos;
    }
    public void
    agregarEstudiante(Estudiante e) {
        estudiantes.add(e);
    }
}
